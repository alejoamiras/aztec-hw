{
  "name": "@aztec-hwwallet-poc/adapter-ledger",
  "version": "0.0.1",
  "private": true,
  "description": "Ledger BOLOS app adapter for Aztec. Talks to the device via Speculos (test) or @ledgerhq/hw-transport (real hardware). Mirrors @aztec-hwwallet-poc/adapter-trezor.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen:clear-signing-v0": "bun scripts/gen-clear-signing-v0.ts",
    "gen:clear-signing-v0:check": "bun scripts/gen-clear-signing-v0.ts --check",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aztec-hwwallet-poc/core": "workspace:*",
    "@aztec/accounts": "4.2.1",
    "@aztec/aztec.js": "4.2.1",
    "@aztec/entrypoints": "4.2.1",
    "@aztec/foundation": "4.2.1",
    "@aztec/pxe": "4.2.1",
    "@aztec/stdlib": "4.2.1",
    "@aztec/wallets": "4.2.1",
    "@ledgerhq/hw-transport": "^6.35.2",
    "@ledgerhq/hw-transport-webhid": "^6.35.2",
    "@noble/secp256k1": "^3.1.0"
  },
  "devDependencies": {
    "@aztec/noir-contracts.js": "4.2.1",
    "@defi-wonderland/aztec-standards": "4.2.0-aztecnr-rc.2"
  }
}
