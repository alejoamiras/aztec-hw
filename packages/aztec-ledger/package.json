{
  "name": "@alejoamiras/aztec-ledger-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Ledger BOLOS app adapter for Aztec. Talks to the device via Speculos (test) or @ledgerhq/hw-transport (real hardware).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./advanced": "./src/advanced.ts",
    "./node-hid": "./src/node-hid.ts",
    "./speculos": "./src/speculos.ts",
    "./unsafe": "./src/unsafe.ts",
    "./webhid": "./src/webhid.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "gen:golden-vectors": "bun scripts/gen-golden-vectors.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alejoamiras/aztec-ledger-core": "workspace:*",
    "@ledgerhq/hw-transport": "^6.35.2",
    "@ledgerhq/hw-transport-webhid": "^6.35.2",
    "@noble/secp256k1": "^3.1.0"
  },
  "devDependencies": {
    "@aztec/accounts": "4.2.1",
    "@aztec/aztec.js": "4.2.1",
    "@aztec/entrypoints": "4.2.1",
    "@aztec/foundation": "4.2.1",
    "@aztec/stdlib": "4.2.1"
  },
  "peerDependencies": {
    "@aztec/accounts": "4.2.1",
    "@aztec/aztec.js": "4.2.1",
    "@aztec/entrypoints": "4.2.1",
    "@aztec/foundation": "4.2.1",
    "@aztec/stdlib": "4.2.1",
    "@ledgerhq/hw-transport-node-hid": "^6.33.2"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/hw-transport-node-hid": {
      "optional": true
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./advanced": {
        "types": "./dist/advanced.d.ts",
        "import": "./dist/advanced.js"
      },
      "./node-hid": {
        "types": "./dist/node-hid.d.ts",
        "import": "./dist/node-hid.js"
      },
      "./speculos": {
        "types": "./dist/speculos.d.ts",
        "import": "./dist/speculos.js"
      },
      "./unsafe": {
        "types": "./dist/unsafe.d.ts",
        "import": "./dist/unsafe.js"
      },
      "./webhid": {
        "types": "./dist/webhid.d.ts",
        "import": "./dist/webhid.js"
      }
    }
  }
}
